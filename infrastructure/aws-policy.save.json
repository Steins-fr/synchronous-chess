            ],
            "Resource": "arn:aws:dynamodb:eu-west-1:404273159415:table/sc_rooms_dev"
        }
    ]
}
// Deployment role of GitHub Actions (OIDC, secrets.AWS_ROLE_ARN): what the Aurora cluster adds, for each stage
// (sc-database-<stage>). Terraform creates its network, the cluster, its instance and its Data API policy; RDS creates
// the secret of the master user, describing its KMS key (aws/secretsmanager) with the rights of the caller. Terraform
// invokes the migrate lambda, and creates the roles sc_lambda_database_<stage> and sc_lambda_migrate_<stage> (the
// lambda roles of the statements above)
{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "DatabaseNetwork",
            "Effect": "Allow",
            "Action": [
                "ec2:CreateVpc",
                "ec2:DeleteVpc",
                "ec2:ModifyVpcAttribute",
                "ec2:CreateSubnet",
                "ec2:DeleteSubnet",
                "ec2:CreateTags",
                "ec2:DeleteTags",
                "ec2:Describe*"
            ],
            "Resource": "*"
        },
        {
            "Sid": "DatabaseCluster",
            "Effect": "Allow",
            "Action": [
                "rds:CreateDBCluster",
                "rds:ModifyDBCluster",
                "rds:DeleteDBCluster",
                "rds:CreateDBInstance",
                "rds:ModifyDBInstance",
                "rds:DeleteDBInstance",
                "rds:CreateDBSubnetGroup",
                "rds:ModifyDBSubnetGroup",
                "rds:DeleteDBSubnetGroup",
                "rds:EnableHttpEndpoint",
                "rds:DisableHttpEndpoint",
                "rds:AddTagsToResource",
                "rds:RemoveTagsFromResource",
                "rds:ListTagsForResource",
                "rds:Describe*"
            ],
            "Resource": "*"
        },
        {
            "Sid": "DatabaseServiceRole",
            "Effect": "Allow",
            "Action": "iam:CreateServiceLinkedRole",
            "Resource": "arn:aws:iam::404273159415:role/aws-service-role/rds.amazonaws.com/AWSServiceRoleForRDS",
            "Condition": {
                "StringEquals": {
                    "iam:AWSServiceName": "rds.amazonaws.com"
                }
            }
        },
        {
            "Sid": "DatabaseSecret",
            "Effect": "Allow",
            "Action": [
                "secretsmanager:CreateSecret",
                "secretsmanager:DeleteSecret",
                "secretsmanager:DescribeSecret",
                "secretsmanager:UpdateSecret",
                "secretsmanager:RotateSecret",
                "secretsmanager:TagResource"
            ],
            "Resource": "arn:aws:secretsmanager:eu-west-1:404273159415:secret:rds!cluster-*"
        },
        {
            "Sid": "DatabaseSecretKey",
            "Effect": "Allow",
            "Action": "kms:DescribeKey",
            "Resource": "*"
        },
        {
            "Sid": "DatabaseMigrations",
            "Effect": "Allow",
            "Action": "lambda:InvokeFunction",
            "Resource": "arn:aws:lambda:eu-west-1:404273159415:function:sc_migrate_*"
        },
        {
            "Sid": "DatabasePolicy",
            "Effect": "Allow",
            "Action": [
                "iam:CreatePolicy",
                "iam:DeletePolicy",
                "iam:GetPolicy",
                "iam:GetPolicyVersion",
                "iam:ListPolicyVersions",
                "iam:CreatePolicyVersion",
                "iam:DeletePolicyVersion",
                "iam:TagPolicy"
            ],
            "Resource": "arn:aws:iam::404273159415:policy/sc-database-*"
        }
    ]
}
// Deployment role of GitHub Actions (OIDC, secrets.AWS_ROLE_ARN): what the HTTP API adds, for each stage
// (sc-http-<stage>, on sc-api-<stage>), to grant by hand before its first apply. Its stage $default writes its access
// logs through a log delivery of CloudWatch Logs, set up with the rights of the caller, where the WebSocket stage
// writes them with the role of the API Gateway account (api_gateway_cloudwatch_global): the statement below, from
// "HTTP API logging" of the API Gateway guide, but logs:CreateLogGroup and the reads of the log groups, which the role
// has for the groups it creates. Where its statements are scoped by name, the role also needs the function
// sc_httpapi_<stage> and the role sc_lambda_httpapi_<stage> (create, tag, PassRole, attach AWSLambdaBasicExecutionRole
// and sc-database-<stage>), like the lambdas and the roles of the statements above; API Gateway on the new API (its
// stage, integration, route and mapping) and its domain sc-api-<stage>; ACM and Route 53 for the certificate of
// sc-api-<stage> and its records, like the ones of sc-ws-<stage>
{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "HttpApiAccessLogs",
            "Effect": "Allow",
            "Action": [
                "logs:CreateLogDelivery",
                "logs:GetLogDelivery",
                "logs:UpdateLogDelivery",
                "logs:DeleteLogDelivery",
                "logs:ListLogDeliveries",
                "logs:PutResourcePolicy",
                "logs:DescribeResourcePolicies"
            ],
            "Resource": "*"
        }
    ]
}
