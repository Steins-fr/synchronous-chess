                "arn:aws:lambda:eu-west-1:404273159415:function:sc_onconnect_dev",
                "arn:aws:lambda:eu-west-1:404273159415:function:sc_ondisconnect_dev",
                "arn:aws:lambda:eu-west-1:404273159415:function:sc_sendmessage_dev",
