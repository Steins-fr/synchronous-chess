{
    "name": "synchronous-chess",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "serve:local": "ng serve --configuration local",
        "build": "ng build",
        "watch": "ng build --watch --configuration local",
        "build:prod": "ng build --prod",
        "build:staging": "ng build --configuration staging",
        "test": "ng test",
        "test:ci": "ng test --watch=false --coverage",
        "lint": "ng lint",
        "e2e": "playwright test",
        "e2e:fast": "playwright test --grep-invert @slow",
        "e2e:slow": "playwright test --grep @slow",
        "sonar-rules": "node ../../shared/sonar-eslint-rules/generate.mjs",
        "i18n:extract": "transloco-keys-manager extract --input src/app --output src/i18n --langs en fr es pt-BR pt-PT de ru tr id pl it --unflat --sort --remove-extra-keys"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "^22.2.1",
        "@angular/cdk": "^22.2.1",
        "@angular/common": "^22.2.1",
        "@angular/compiler": "^22.2.1",
        "@angular/core": "^22.2.1",
        "@angular/forms": "^22.2.1",
        "@angular/material": "^22.2.1",
        "@angular/platform-browser": "^22.2.1",
        "@angular/platform-browser-dynamic": "^22.2.1",
        "@angular/router": "^22.2.1",
        "@jsverse/transloco": "^8.4.0",
        "@jsverse/transloco-messageformat": "^8.4.0",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@angular/build": "^22.2.1",
        "@angular/cli": "^22.2.1",
        "@angular/compiler-cli": "^22.2.1",
        "@eslint/js": "^10.0.1",
        "@html-eslint/eslint-plugin": "^0.67.0",
        "@jsverse/transloco-keys-manager": "^8.1.1",
        "@messageformat/parser": "^5.2.0",
        "@playwright/test": "^1.63.0",
        "@stylistic/eslint-plugin": "^5.2.2",
        "@tailwindcss/postcss": "^4.1.12",
        "@types/node": "^25.5.0",
        "@vitest/coverage-v8": "^5.0.5",
        "angular-eslint": "22.6.0",
        "eslint": "^10.10.0",
        "eslint-plugin-promise": "^7.3.0",
        "eslint-plugin-rxjs-angular-x": "^1.0.1",
        "eslint-plugin-rxjs-x": "^1.0.6",
        "eslint-plugin-sonarjs": "^4.2.2",
        "eslint-plugin-unicorn": "^78.0.0",
        "fake-indexeddb": "^6.2.5",
        "jsdom": "^30.1.3",
        "postcss": "^8.5.3",
        "tailwindcss": "^4.1.13",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.70.0",
        "vitest": "^5.0.5"
    }
}
