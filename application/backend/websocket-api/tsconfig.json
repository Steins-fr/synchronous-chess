{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "ES2022",
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "noImplicitOverride": true,
        "noPropertyAccessFromIndexSignature": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "esModuleInterop": true,
        // The declarations of drizzle-orm 1.0 RC and PGlite do not compile under TypeScript 6 (the drivers of the other
        // databases, the DOM types of PGlite): checked as they are used only
        "skipLibCheck": true,
        "declaration": false,
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "typeRoots": ["node_modules/@types"],
        "types": ["node"],
        "paths": {
            "@database/*": ["./shared/database/*"],
            "@exceptions/*": ["./shared/exceptions/*"],
            "@helpers/*": ["./shared/helpers/*"],
            "@models/*": ["./shared/models/*"],
            "@protocol/*": ["../../shared/room-socket-protocol/*"],
            "@repositories/*": ["./shared/repositories/*"],
            "@services/*": ["./shared/services/*"],
            "@testing/*": ["./testing/*"],
        },
    }
}
