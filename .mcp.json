{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--browser",
        "chromium",
        "--isolated",
        "--headless"
      ],
      "env": {}
    },
    "sonarqube": {
      "type": "stdio",
      "command": "sonar",
      "args": [
        "run",
        "mcp",
        "--project",
        "Steins-fr_synchronous-chess"
      ],
      "env": {}
    }
  }
}
